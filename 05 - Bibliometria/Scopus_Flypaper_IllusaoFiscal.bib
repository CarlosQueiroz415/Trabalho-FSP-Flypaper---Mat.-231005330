	affiliations = {Government Inst. for Econ. Research, Helsinki 00531, Hämeentie 3, Finland},
	abstract = {A basic model of fiscal policy states that changes in unconditional lump-sum grants and private incomes affect local government expenditures equally However, many empirical studies have shown that lump-sum grants stimulate local public spending more than private incomes. This finding has been called the 'flypaper effect', because money seems to stick where it first hits. Inman (1979) surveyed the early studies on the topic and Hines and Thaler (1995) summarised the more recent literature. This paper focuses on the existence of the flypaper effect among the Finnish municipalities. Seven expenditure categories are analysed using data for 436 municipalities during the first seven years (1993-99) of the formula-based period. The results obtained lend strong support to the flypaper effect because the estimates for nonearmarked formula-based grant parameters were clearly larger than the income parameters for most of the expenditure categories studied. The results here are therefore more in line with the bureaucratic decisionmaking and asymmetric voter information models that are the usual explanations for this result. The organisation of this chapter is as follows. In the second section the theoretical aspects of the research issue are discussed. In the third section the empirical model and the data are presented. The fourth section presents the results of the estimations and the fifth section summarises and concludes the chapter.},
	keywords = {Eurasia; Europe; Finland; Northern Europe; Scandinavia; fiscal policy; local government; public spending; tax system},
