@ARTICLE{Brunner201538,
	author = {Brunner, Eric J. and Ross, Stephen L. and Simonsen, Becky K.},
	title = {Homeowners, renters and the political economy of property taxation},
	year = {2015},
	journal = {Regional Science and Urban Economics},
	volume = {53},
	pages = {38 - 49},
	doi = {10.1016/j.regsciurbeco.2015.04.001},
	url = {https://www.scopus.com/pages/publications/84929080607?origin=resultslist},
	affiliations = {Department of Public Policy, University of Connecticut, 1800 Asylum Ave., 4th Floor, West Hartford, 06117, CT, United States; Urban Institute, 2100 M Street, NW, Washington, 20037, DC, United States; Department of Economics, University of Connecticut, 341 Mansfield Road, Unit 1063, Storrs, 06269-1063, CT, United States},
	abstract = {Studies find that renters are more supportive of public spending that is financed by the property tax than homeowners, a finding commonly referred to as the "renter effect." The renter effect suggests that, all else equal, renters should prefer property taxation over other forms of taxation. We test that hypothesis using detailed micro-level survey data that contains voter responses to two key questions: their willingness to pay higher property taxes to fund public services and their willingness to pay higher sales taxes to fund those services. Using a difference-in-differences estimation strategy, we find first that renters are approximately 10 to 18 percentage points more likely than homeowners to favor a property tax increase over a sales tax increase, a finding consistent with the presence of a renter effect. However, these results are not driven by the survey responses of renters. Analysis based on separate regressions for renters and homeowners reveals that renters are indifferent between a property tax increase and either a sales tax or state income tax increase, while homeowners strongly oppose a property tax increase relative to either a sales tax or state income tax increase. Further, the strong opposition among homeowners to the property tax is not eroded by including controls for income and other demographics as might be expected if these differences were driven by economic incentives. Finally, an examination of the variation in tax burden created by Proposition 13 in California shows no evidence that homeowner aversion to the property tax increases with the homeowner's relative tax burden. These findings of homeowner aversion to property taxes are consistent with recent work suggesting that salience matters when voters evaluate taxes, but also suggest that increased salience does not necessarily lead to more careful consideration of individual tax burdens. © 2015 Elsevier B.V.},
	author_keywords = {Fiscal illusion; Local public goods; Renter effect},
	keywords = {California; United States; homeowner; political economy; public service; public spending; tax system; willingness to pay},
	publisher = {Elsevier},
	issn = {01660462},
	language = {English},
	abbrev_source_title = {Reg. Sci. Urban Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19}
}

@ARTICLE{Bakri2026,
	author = {Bakri, Muhammad Rafi},
	title = {Decentralised budgets but centralised liabilities in Indonesia’s local government},
	year = {2026},
	journal = {Local Economy},
	pages = {},
	doi = {10.1177/02690942261490434},
	url = {https://www.scopus.com/pages/publications/105050767907?origin=resultslist},
	affiliations = {Research Analyst, The Audit Board of the Republic of Indonesia, Jakarta, Indonesia},
	abstract = {Indonesia’s decentralisation dramatically expanded the responsibilities and budgets of subnational governments, but the volume of expenditure executed locally increasingly reveals less about the degree of choice exercised locally. This Viewpoint argues that Indonesia is experiencing a form of quiet recentralisation by mandate. Formal local authority remains substantial, yet the centre increasingly shapes the composition, timing, and administrative use of subnational resources. Drawing on decentralisation, place-based development, and intergovernmental finance scholarship, the article reframes local fiscal autonomy around discretionary fiscal space: the share of a local budget that remains available for meaningful local prioritisation after pre-committed expenditure is accounted for. Three mechanisms are distinguished: fiscal steering through specified-use transfers, administrative steering through nationally designed programmes, and liability steering through recurrent personnel commitments. These mechanisms need not be undesirable individually. The problem arises when their cumulative effect leaves elected local governments responsible for local development while controlling too little of the marginal budget to respond to place-specific needs. Indonesia therefore illustrates why decentralisation should be assessed not only by who spends public money, but by who can still decide what the marginal rupiah is for. © The Author(s) 2026},
	author_keywords = {decentralisation; fiscal autonomy; Indonesia; intergovernmental transfers; local economic development; local government},
	correspondence_address = {M.R. Bakri; Research Analyst, The Audit Board of Indonesia, Jakarta, Gatot Subrot Street Number 31, 10210, Indonesia; email: muhammad.bakri@bpk.go.id},
