	author = {Jimenez, Benedict S. and Afonso, Whitney B.},
	title = {Revisiting the theory of revenue diversification: Insights from an empirical analysis of municipal budgetary solvency},
	year = {2022},
	journal = {Public Budgeting and Finance},
	volume = {42},
